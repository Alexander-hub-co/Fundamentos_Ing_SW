# Copiar este archivo a .env y completar los valores.
# .env NUNCA se versiona.

# --- Base de datos -------------------------------------------------------
# Tres roles distintos, a propósito. Ver data-model.md.
#
#   app_migrator  dueño del esquema. Sólo migraciones, nunca la app en marcha.
#   app_platform  con BYPASSRLS. Sólo autenticación y administración global.
#   app_tenant    sin BYPASSRLS y sin ser dueño. Todo lo demás.
#
DATABASE_URL_MIGRATOR=postgresql://app_migrator:CAMBIAR@localhost:5432/parqueadero
DATABASE_URL_PLATFORM=postgresql://app_platform:CAMBIAR@localhost:5432/parqueadero
DATABASE_URL_TENANT=postgresql://app_tenant:CAMBIAR@localhost:5432/parqueadero

# --- Sesión --------------------------------------------------------------
# Generar con: openssl rand -base64 32
AUTH_SECRET=CAMBIAR
APP_URL=http://localhost:3000
